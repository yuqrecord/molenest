import { Button, LineEdit, ListView, ScrollView } from "std-widgets.slint";

export struct PresetRow {
    name: string,
    host: string,
    local-port: string,
    remote: string,
    status: string,
}

export struct ConnectionDetails {
    name: string,
    status: string,
    local-url: string,
    command: string,
    started-at: string,
    output: string,
}

component PresetListPanel inherits Rectangle {
    in property <[PresetRow]> presets;
    in-out property <int> selected-index: -1;
    callback selected(int);

    border-color: #d6dce5;
    border-width: 1px;
    border-radius: 8px;
    background: white;
    horizontal-stretch: 3;
    vertical-stretch: 1;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Text {
            text: "Presets";
            font-size: 18px;
            font-weight: 700;
            color: #20242a;
        }

        if root.presets.length == 0 : Rectangle {
            min-height: 260px;
            vertical-stretch: 1;
            Text {
                text: "No presets found. Use Add Preset to create one.";
                color: #657080;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ListView {
            for row[index] in root.presets : Rectangle {
                height: 68px;
                border-radius: 6px;
                background: root.selected-index == index ? #e7f0ff : white;

                TouchArea {
                    clicked => {
                        root.selected-index = index;
                        root.selected(index);
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: row.name;
                                color: #1f2933;
                                font-weight: 700;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.local-port;
                                color: #526070;
                                horizontal-alignment: right;
                                horizontal-stretch: 0;
                            }
                        }

                        Text {
                            text: row.host + "  ->  " + row.remote;
                            color: #526070;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    Text {
                        text: row.status;
                        width: 86px;
                        horizontal-stretch: 0;
                        horizontal-alignment: right;
                        color: row.status == "running" ? #067647 : row.status == "failed" ? #b42318 : #526070;
                    }
                }
            }
        }
    }
}

component DetailsPanel inherits Rectangle {
    in property <ConnectionDetails> details;
    in property <int> selected-index: -1;
    callback start-requested();
    callback stop-requested();

    border-color: #d6dce5;
    border-width: 1px;
    border-radius: 8px;
    background: white;
    min-width: 300px;
    horizontal-stretch: 2;
    vertical-stretch: 1;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Text {
            text: root.details.name == "" ? "Connection" : root.details.name;
            font-size: 20px;
            font-weight: 700;
            color: #20242a;
            overflow: elide;
        }

        GridLayout {
            spacing: 8px;
            Text { text: "Status"; color: #657080; }
            Text { text: root.details.status; color: #20242a; overflow: elide; }
            Text { text: "Local URL"; color: #657080; }
            Text { text: root.details.local-url; color: #20242a; overflow: elide; }
            Text { text: "Started"; color: #657080; }
            Text { text: root.details.started-at; color: #20242a; overflow: elide; }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Start";
                enabled: root.selected-index >= 0;
                clicked => { root.start-requested(); }
            }
            Button {
                text: "Stop";
                enabled: root.selected-index >= 0;
                clicked => { root.stop-requested(); }
            }
        }

        Text {
            text: "Command";
            font-weight: 700;
            color: #596273;
        }
        Rectangle {
            background: #f3f5f8;
            border-radius: 6px;
            height: 58px;
            Text {
                text: root.details.command;
                color: #29313d;
                font-family: "monospace";
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Text {
            text: "Recent Output";
            font-weight: 700;
            color: #596273;
        }
        Rectangle {
            background: #101820;
            border-radius: 6px;
            min-height: 220px;
            vertical-stretch: 1;

            ScrollView {
                Text {
                    text: root.details.output;
                    color: #d9e2ec;
                    font-family: "monospace";
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "molenest";
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 560px;
    background: #f7f8fa;

    in property <[PresetRow]> presets;
    in-out property <int> selected-index: -1;
    in property <ConnectionDetails> details;
    in property <string> status-message;
    in property <string> config-path;
    in-out property <string> draft-name;
    in-out property <string> draft-host;
    in-out property <string> draft-local-port;
    in-out property <string> draft-remote-host: "127.0.0.1";
    in-out property <string> draft-remote-port;
    in-out property <bool> add-dialog-open;

    callback selected(int);
    callback start-requested();
    callback stop-requested();
    callback reload-requested();
    callback add-preset-requested();
    callback doctor-requested();

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            alignment: space-between;
            spacing: 12px;

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "molenest";
                    font-size: 26px;
                    font-weight: 700;
                    color: #20242a;
                }
                Text {
                    text: root.config-path;
                    font-size: 12px;
                    color: #657080;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 0;
                Button {
                    text: "Add Preset";
                    clicked => { root.add-dialog-open = true; }
                }
                Button {
                    text: "Doctor";
                    clicked => { root.doctor-requested(); }
                }
                Button {
                    text: "Reload";
                    clicked => { root.reload-requested(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            PresetListPanel {
                presets: root.presets;
                selected-index <=> root.selected-index;
                selected(index) => { root.selected(index); }
            }

            DetailsPanel {
                details: root.details;
                selected-index: root.selected-index;
                start-requested => { root.start-requested(); }
                stop-requested => { root.stop-requested(); }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 6px;
            background: #eef2f7;
            Text {
                text: root.status-message;
                color: #475467;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }

    if root.add-dialog-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000066;

        TouchArea {}

        Rectangle {
            width: root.width < 560px ? root.width - 36px : 520px;
            height: root.height < 620px ? root.height - 48px : 560px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 8px;
            border-color: #c9d2df;
            border-width: 1px;
            background: white;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Add Preset";
                    font-size: 22px;
                    font-weight: 700;
                    color: #20242a;
                }

                Text { text: "Name"; color: #657080; }
                LineEdit { text <=> root.draft-name; }

                Text { text: "Host"; color: #657080; }
                LineEdit { text <=> root.draft-host; }

                Text { text: "Local Port"; color: #657080; }
                LineEdit { text <=> root.draft-local-port; input-type: number; }

                Text { text: "Remote Host"; color: #657080; }
                LineEdit { text <=> root.draft-remote-host; }

                Text { text: "Remote Port"; color: #657080; }
                LineEdit { text <=> root.draft-remote-port; input-type: number; }

                Rectangle {
                    height: 42px;
                    background: #f3f5f8;
                    border-radius: 6px;
                    Text {
                        text: root.status-message;
                        color: #475467;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.add-dialog-open = false; }
                    }
                    Button {
                        text: "Add";
                        clicked => { root.add-preset-requested(); }
                    }
                }
            }
        }
    }
}
