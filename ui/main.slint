import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct PresetRow {
    name: string,
    host: string,
    local-port: string,
    remote: string,
    status: string,
    status-time: string,
}

component PresetListPanel inherits Rectangle {
    in property <[PresetRow]> presets;

    callback start(int);
    callback stop(int);

    border-color: #20242a;
    border-width: 1px;
    background: white;
    vertical-stretch: 1;

    VerticalLayout {
        padding: 18px;
        spacing: 16px;

        Text {
            text: "Presets";
            font-size: 22px;
            color: #111111;
        }

        HorizontalLayout {
            padding-left: 0px;
            padding-right: 0px;
            spacing: 16px;
            alignment: center;

            Rectangle { width: 82px; }
            Rectangle { width: 82px; }
            Text { text: "Name"; color: #111111; font-size: 18px; horizontal-stretch: 2; overflow: elide; }
            Text { text: "Local"; color: #111111; font-size: 18px; width: 66px; horizontal-stretch: 0; horizontal-alignment: right; }
            Text { text: "Host"; color: #111111; font-size: 18px; horizontal-stretch: 2; overflow: elide; }
            Text { text: "Remote"; color: #111111; font-size: 18px; horizontal-stretch: 2; overflow: elide; }
            Text { text: "Status"; color: #111111; font-size: 18px; width: 180px; horizontal-stretch: 0; }
        }

        if root.presets.length == 0 : Rectangle {
            min-height: 260px;
            vertical-stretch: 1;
            Text {
                text: "No presets found. Use Add Preset to create one.";
                color: #657080;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ListView {
            for row[index] in root.presets : Rectangle {
                height: 56px;
                background: white;

                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    Button {
                        text: "Start";
                        width: 82px;
                        enabled: row.status != "Running";
                        clicked => { root.start(index); }
                    }

                    Button {
                        text: "Stop";
                        width: 82px;
                        enabled: row.status == "Running";
                        clicked => { root.stop(index); }
                    }

                    Text {
                        text: row.name;
                        color: #111111;
                        font-size: 18px;
                        horizontal-stretch: 2;
                        overflow: elide;
                    }

                    Text {
                        text: row.local-port;
                        color: #111111;
                        font-size: 18px;
                        width: 66px;
                        horizontal-stretch: 0;
                        horizontal-alignment: right;
                    }

                    Text {
                        text: row.host;
                        color: #111111;
                        font-size: 18px;
                        horizontal-stretch: 2;
                        overflow: elide;
                    }

                    Text {
                        text: row.remote;
                        color: #111111;
                        font-size: 18px;
                        horizontal-stretch: 2;
                        overflow: elide;
                    }

                    VerticalLayout {
                        width: 180px;
                        horizontal-stretch: 0;
                        spacing: 2px;

                        Text {
                            text: row.status;
                            color: row.status == "Running" ? #067647 : row.status == "Failed" ? #b42318 : #475467;
                            font-size: 16px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: row.status-time;
                            color: #657080;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "molenest";
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 520px;
    background: white;

    in property <[PresetRow]> presets;
    in property <string> status-message;
    in property <string> config-path;
    in-out property <string> draft-name;
    in-out property <string> draft-host;
    in-out property <string> draft-local-port;
    in-out property <string> draft-remote-host: "127.0.0.1";
    in-out property <string> draft-remote-port;
    in-out property <bool> add-dialog-open;

    callback start-requested(int);
    callback stop-requested(int);
    callback reload-requested();
    callback add-preset-requested();

    VerticalLayout {
        padding: 18px;
        spacing: 18px;

        Text {
            text: "molenest";
            font-size: 28px;
            color: #111111;
        }

        HorizontalLayout {
            spacing: 22px;
            alignment: center;

            Button {
                text: "Reload";
                width: 112px;
                clicked => { root.reload-requested(); }
            }

            Text {
                text: root.config-path;
                color: #111111;
                font-size: 18px;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Button {
                text: "Add Preset";
                width: 118px;
                clicked => { root.add-dialog-open = true; }
            }
        }

        Rectangle {
            height: 44px;
            border-color: #20242a;
            border-width: 1px;
            background: white;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: root.status-message == "" ? "Message" : root.status-message;
                    color: #111111;
                    font-size: 18px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        PresetListPanel {
            presets: root.presets;
            start(index) => { root.start-requested(index); }
            stop(index) => { root.stop-requested(index); }
        }
    }

    if root.add-dialog-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000066;

        TouchArea {}

        Rectangle {
            width: root.width < 560px ? root.width - 36px : 520px;
            height: root.height < 620px ? root.height - 48px : 560px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 8px;
            border-color: #c9d2df;
            border-width: 1px;
            background: white;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Add Preset";
                    font-size: 22px;
                    font-weight: 700;
                    color: #20242a;
                }

                Text { text: "Name"; color: #657080; }
                LineEdit { text <=> root.draft-name; }

                Text { text: "Host"; color: #657080; }
                LineEdit { text <=> root.draft-host; }

                Text { text: "Local Port"; color: #657080; }
                LineEdit { text <=> root.draft-local-port; input-type: number; }

                Text { text: "Remote Host"; color: #657080; }
                LineEdit { text <=> root.draft-remote-host; }

                Text { text: "Remote Port"; color: #657080; }
                LineEdit { text <=> root.draft-remote-port; input-type: number; }

                Rectangle {
                    height: 42px;
                    background: #f3f5f8;
                    border-radius: 6px;
                    Text {
                        text: root.status-message;
                        color: #475467;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.add-dialog-open = false; }
                    }
                    Button {
                        text: "Add";
                        clicked => { root.add-preset-requested(); }
                    }
                }
            }
        }
    }
}
