import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct PresetRow {
    name: string,
    host: string,
    local-port: string,
    remote: string,
    status: string,
    status-time: string,
}

component ConnectionToggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;

    callback toggled(bool);

    width: 56px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.checked ? #027a48 : #98a2b3;
    background: root.checked ? #12b76a : #d0d5dd;
    opacity: root.enabled ? 1 : 0.55;

    Rectangle {
        width: 22px;
        height: 22px;
        x: root.checked ? 31px : 3px;
        y: 3px;
        border-radius: 11px;
        background: #ffffff;
        border-width: 1px;
        border-color: #ffffff;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            if root.enabled {
                root.toggled(!root.checked);
            }
        }
    }
}

component PresetListPanel inherits Rectangle {
    in property <[PresetRow]> presets;

    callback add-preset();
    callback toggle(int);

    border-color: #d9e1ec;
    border-width: 1px;
    border-radius: 8px;
    background: #ffffff;
    vertical-stretch: 1;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Text {
                text: "Presets";
                font-size: 22px;
                font-weight: 700;
                color: #182230;
                horizontal-stretch: 1;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Button {
                text: "Add Preset";
                width: 118px;
                clicked => { root.add-preset(); }
            }
        }

        Rectangle {
            height: 38px;
            border-radius: 6px;
            background: #f3f6fa;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 14px;
                alignment: start;

                Text { text: "Active"; color: #566276; font-size: 13px; font-weight: 700; width: 76px; horizontal-stretch: 0; horizontal-alignment: left; }
                Text { text: "Name"; color: #566276; font-size: 13px; font-weight: 700; horizontal-stretch: 2; horizontal-alignment: left; overflow: elide; }
                Text { text: "Local"; color: #566276; font-size: 13px; font-weight: 700; width: 70px; horizontal-stretch: 0; horizontal-alignment: left; }
                Text { text: "Host"; color: #566276; font-size: 13px; font-weight: 700; horizontal-stretch: 2; horizontal-alignment: left; overflow: elide; }
                Text { text: "Remote"; color: #566276; font-size: 13px; font-weight: 700; horizontal-stretch: 2; horizontal-alignment: left; overflow: elide; }
                Text { text: "Status"; color: #566276; font-size: 13px; font-weight: 700; width: 190px; horizontal-stretch: 0; horizontal-alignment: left; }
            }
        }

        if root.presets.length == 0 : Rectangle {
            min-height: 260px;
            vertical-stretch: 1;
            Text {
                text: "No presets found. Use Add Preset to create one.";
                color: #657080;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ListView {
            for row[index] in root.presets : Rectangle {
                height: 58px;
                border-radius: 6px;
                background: Math.mod(index, 2) == 0 ? #ffffff : #f9fbfd;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 14px;
                    alignment: start;

                    Rectangle {
                        width: 76px;
                        height: 28px;
                        horizontal-stretch: 0;

                        ConnectionToggle {
                            x: 0px;
                            y: 0px;
                            checked: row.status == "Running";
                            toggled(_) => { root.toggle(index); }
                        }
                    }

                    Text {
                        text: row.name;
                        color: #182230;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-stretch: 2;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    Text {
                        text: row.local-port;
                        color: #344054;
                        font-size: 15px;
                        width: 70px;
                        horizontal-stretch: 0;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: row.host;
                        color: #344054;
                        font-size: 15px;
                        horizontal-stretch: 2;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    Text {
                        text: row.remote;
                        color: #344054;
                        font-size: 15px;
                        horizontal-stretch: 2;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    VerticalLayout {
                        width: 190px;
                        horizontal-stretch: 0;
                        alignment: start;
                        spacing: 2px;

                        Text {
                            text: row.status;
                            color: row.status == "Running" ? #067647 : row.status == "Failed" ? #b42318 : #475467;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        Text {
                            text: row.status-time;
                            color: #657080;
                            font-size: 11px;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "molenest";
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 520px;
    background: #f5f7fb;

    in property <[PresetRow]> presets;
    in property <string> status-message;
    in property <string> config-path;
    in-out property <string> draft-name;
    in-out property <string> draft-host;
    in-out property <string> draft-local-port;
    in-out property <string> draft-remote-host: "127.0.0.1";
    in-out property <string> draft-remote-port;
    in-out property <bool> add-dialog-open;

    callback toggle-requested(int);
    callback reload-requested();
    callback add-preset-requested();

    VerticalLayout {
        padding: 18px;
        spacing: 18px;

        Text {
            text: "molenest";
            font-size: 28px;
            font-weight: 700;
            color: #182230;
        }

        HorizontalLayout {
            spacing: 22px;
            alignment: start;

            Button {
                text: "Reload";
                width: 112px;
                clicked => { root.reload-requested(); }
            }

            Text {
                text: root.config-path;
                color: #566276;
                font-size: 15px;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 44px;
            border-color: #d9e1ec;
            border-width: 1px;
            border-radius: 8px;
            background: #ffffff;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: start;

                Text {
                    text: root.status-message == "" ? "Message" : root.status-message;
                    color: #344054;
                    font-size: 14px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        PresetListPanel {
            presets: root.presets;
            add-preset => { root.add-dialog-open = true; }
            toggle(index) => { root.toggle-requested(index); }
        }
    }

    if root.add-dialog-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000066;

        TouchArea {}

        Rectangle {
            width: root.width < 560px ? root.width - 36px : 520px;
            height: root.height < 620px ? root.height - 48px : 560px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 8px;
            border-color: #c9d2df;
            border-width: 1px;
            background: white;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Add Preset";
                    font-size: 22px;
                    font-weight: 700;
                    color: #20242a;
                }

                Text { text: "Name"; color: #657080; }
                LineEdit { text <=> root.draft-name; }

                Text { text: "Host"; color: #657080; }
                LineEdit { text <=> root.draft-host; }

                Text { text: "Local Port"; color: #657080; }
                LineEdit { text <=> root.draft-local-port; input-type: number; }

                Text { text: "Remote Host"; color: #657080; }
                LineEdit { text <=> root.draft-remote-host; }

                Text { text: "Remote Port"; color: #657080; }
                LineEdit { text <=> root.draft-remote-port; input-type: number; }

                Rectangle {
                    height: 42px;
                    background: #f3f5f8;
                    border-radius: 6px;
                    Text {
                        text: root.status-message;
                        color: #475467;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.add-dialog-open = false; }
                    }
                    Button {
                        text: "Add";
                        clicked => { root.add-preset-requested(); }
                    }
                }
            }
        }
    }
}
